#!/bin/sh
# Stands in for sudo -S: reads the password from the first line of stdin.
# "correct-horse" runs the command; anything else fails the way sudo does.
# Records its arguments (never the password) in $SD_STUB_LOG.
IFS= read -r password
for a in "$@"; do printf 'arg: %s\n' "$a"; done >>"${SD_STUB_LOG:?}"
if [ "$password" != correct-horse ]; then
	printf 'Sorry, try again.\nsudo: 1 incorrect password attempt\n' >&2
	exit 1
fi
printf 'password: ok\n' >>"$SD_STUB_LOG"
while [ $# -gt 0 ] && [ "$1" != -- ]; do shift; done
shift
exec "$@"
