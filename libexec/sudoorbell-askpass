#!/bin/sh
# sudoorbell-askpass: the program sudo runs (SUDO_ASKPASS) to get your
# password when there is no terminal to ask in. It shows a dialog naming the
# command and the program that asked, and prints what you type to stdout, which
# only sudo reads. Without a desktop, the request waits for an answer from a
# terminal (`sudoorbell approve`) or a tmux popup instead.
#
# sudo passes its own prompt as $1; the dialog builds a clearer one instead.

here=$(cd "$(dirname "$0")" && pwd -P) || exit 1
# shellcheck source=../lib/sudoorbell.sh
. "$here/../lib/sudoorbell.sh" || exit 1
SD_LIBEXEC=$here

sudo_pid=$PPID

# Only sudo gets a password out of this dialog. Anything else calling it
# directly would otherwise get a ready-made, genuine-looking password prompt.
if [ -z "$(sd_proc comm $$)" ]; then
	# No way to read process information: no /proc and no usable ps, or a
	# sandbox (Codex's, on macOS) forbids it. The caller cannot be checked, so
	# refuse rather than guess.
	sd_err "refusing to ask for a password: cannot check the caller here (process information is not readable: a sandbox, or no ps and no /proc)"
	exit 1
fi
if sd_use_proc && [ ! -r "/proc/$sudo_pid/status" ]; then
	# /proc mounted with hidepid hides sudo (a root process) from us.
	sd_err "refusing to ask for a password: cannot see the calling process (is /proc mounted with hidepid? Its gid= option can let a group see processes)"
	exit 1
fi
if ! sd_parent_is_sudo "$sudo_pid"; then
	sd_err "refusing to ask for a password: the caller is not sudo"
	exit 1
fi

requester=$(sd_requester "$sudo_pid")
# `sudoorbell client off NAME`: not for this program.
if ! sd_client_enabled "$requester"; then
	sd_err "not asking: sudoorbell is off for ${requester:-this program} (turn it on with: sudoorbell client on ${requester:-NAME})"
	exit 1
fi

# Touch ID's own prompt already offered a password ("Use Password…"). Asking
# again would turn its Cancel into a second prompt instead of a no.
if sd_touch_id_was_offered "$sudo_pid"; then
	sd_err "not asking: Touch ID was cancelled"
	exit 1
fi

command=$(sd_command_of "$sudo_pid")
attempt=$(sd_attempt "$sudo_pid")
message=$(sd_message "$command" "$requester" "$attempt")
backend=$(sd_backend)

case $backend in
tmux | terminal) sd_broker "$message" "$backend" "$sudo_pid" ;;
*) sd_ask "$message" "$backend" ;;
esac
