#!/bin/sh
# sudoorbell: set up, check and remove the sudo password dialog.
#
#   sudoorbell install [--shell zsh|bash|fish|sh|all] [--claude-deny] [--claude-mcp[=form|browser]]
#   sudoorbell uninstall [--claude-deny] [--claude-mcp]
#   sudoorbell doctor
#   sudoorbell preview
#   sudoorbell approve [--deny] [--pending] [--pid N [--stdin]]
#
# approve answers sudo requests waiting for you when there is no desktop to
# show a dialog on (SSH, servers, containers). --claude-mcp gives Claude Code a
# sudo tool that asks for the password inside Claude Code (form) or on a local
# page it opens (browser). Never runs sudo itself.

set -eu

VERSION=0.1.0
MARK_BEGIN='# >>> sudoorbell >>>'
MARK_END='# <<< sudoorbell <<<'
CLAUDE_RULE='Bash(sudo:*)'
MCP_NAME=sudoorbell

# Where this program really is: the installed command is a symlink in
# ~/.local/bin, and the library lives next to the real file.
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
src=$(cd "$(dirname "$self")/.." && pwd -P)
prefix=${SUDOORBELL_PREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/sudoorbell}
bindir=${SUDOORBELL_BINDIR:-$HOME/.local/bin}
# Set by a package (the Homebrew formula): the package manager owns the files
# in $prefix, so install uses them in place and uninstall leaves them.
packaged=${SUDOORBELL_PACKAGED:-}
claude_settings=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
fish_conf=${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/sudoorbell.fish

# shellcheck source=../lib/sudoorbell.sh
. "$src/lib/sudoorbell.sh"

say() { printf '%s\n' "$*"; }
die() {
	printf 'sudoorbell: %s\n' "$*" >&2
	exit 1
}

usage() {
	sed -n '2,15s/^# \{0,1\}//p' "$0"
}

# ── shell startup files ──────────────────────────────────────

rc_files() {
	case $1 in
	zsh) printf '%s\n' "${ZDOTDIR:-$HOME}/.zshenv" ;;
	bash)
		printf '%s\n' "$HOME/.bashrc"
		# Login shells (`bash -l`, used by some agents) read .bash_profile
		# and may not read .bashrc.
		[ -f "$HOME/.bash_profile" ] && printf '%s\n' "$HOME/.bash_profile"
		;;
	# POSIX login shells (sh -l, dash, BusyBox ash) read ~/.profile.
	sh) printf '%s\n' "$HOME/.profile" ;;
	esac
	return 0
}

block() {
	printf '%s\n' "$MARK_BEGIN" \
		"# Password dialog for sudo when there is no terminal. Remove with: sudoorbell uninstall" \
		"export SUDOORBELL_HOME=\"$prefix\"" \
		"[ -r \"\$SUDOORBELL_HOME/shell/sudoorbell.sh\" ] && . \"\$SUDOORBELL_HOME/shell/sudoorbell.sh\"" \
		"$MARK_END"
}

# Print file $1 without the sudoorbell block.
without_block() {
	awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
		$0 == b { inside = 1; next }
		$0 == e { inside = 0; next }
		!inside { print }
	' "$1"
}

has_block() {
	[ -f "$1" ] && grep -qxF "$MARK_BEGIN" "$1"
}

# add_block FILE top|bottom: put the block in FILE, replacing any earlier one.
# bash startup files go on top: many distributions' ~/.bashrc returns early
# for non-interactive shells, which are the ones agents use.
add_block() {
	file=$1 where=$2
	if [ -f "$file" ] && [ ! -f "$file.sudoorbell.bak" ]; then
		cp -p "$file" "$file.sudoorbell.bak"
	fi
	tmp=$(mktemp "${file}.sudoorbell.XXXXXX")
	if [ "$where" = top ]; then
		block >"$tmp"
		[ -f "$file" ] && without_block "$file" >>"$tmp"
	else
		: >"$tmp"
		[ -f "$file" ] && without_block "$file" >>"$tmp"
		# Start the block on a line of its own.
		[ -s "$tmp" ] && [ -n "$(tail -c 1 "$tmp")" ] && printf '\n' >>"$tmp"
		block >>"$tmp"
	fi
	[ -f "$file" ] && chmod "$(file_mode "$file")" "$tmp"
	mv -f "$tmp" "$file"
}

remove_block() {
	file=$1
	has_block "$file" || return 0
	tmp=$(mktemp "${file}.sudoorbell.XXXXXX")
	without_block "$file" >"$tmp"
	chmod "$(file_mode "$file")" "$tmp"
	mv -f "$tmp" "$file"
}

file_mode() {
	if stat -f '%Lp' "$1" >/dev/null 2>&1; then
		stat -f '%Lp' "$1"
	else
		stat -c '%a' "$1"
	fi
}

detect_shells() {
	found=
	for s in zsh bash fish; do
		command -v "$s" >/dev/null 2>&1 && found="$found $s"
	done
	# A plain POSIX login shell (Alpine's ash, dash), or nothing else at all.
	case ${SHELL##*/} in
	sh | ash | dash) found="$found sh" ;;
	*) [ -n "$found" ] || found='sh' ;;
	esac
	printf '%s\n' "${found# }"
}

# ── Claude Code deny rule ────────────────────────────────────

claude_has_rule() {
	[ -f "$claude_settings" ] &&
		jq -e --arg r "$CLAUDE_RULE" '(.permissions.deny // []) | index($r) != null' "$claude_settings" >/dev/null 2>&1
}

claude_edit() {
	command -v jq >/dev/null 2>&1 || die "jq is needed to edit $claude_settings"
	mkdir -p "$(dirname "$claude_settings")"
	[ -f "$claude_settings" ] || printf '{}\n' >"$claude_settings"
	[ -f "$claude_settings.sudoorbell.bak" ] || cp -p "$claude_settings" "$claude_settings.sudoorbell.bak"
	tmp=$(mktemp "$claude_settings.XXXXXX")
	jq --arg r "$CLAUDE_RULE" "$1" "$claude_settings" >"$tmp"
	mv -f "$tmp" "$claude_settings"
}

# ── commands ─────────────────────────────────────────────────

# Are $1 and $2 the same directory, once symlinks are resolved? False when
# either does not exist.
same_dir() {
	a=$(cd "$1" 2>/dev/null && pwd -P) || return 1
	b=$(cd "$2" 2>/dev/null && pwd -P) || return 1
	[ "$a" = "$b" ]
}

cmd_install() {
	shells='' claude='' mcp=''
	while [ $# -gt 0 ]; do
		case $1 in
		--shell)
			[ $# -ge 2 ] || die "--shell needs a value"
			shells=$2
			shift
			;;
		--claude-deny) claude=1 ;;
		--claude-mcp | --claude-mcp=form) mcp=form ;;
		--claude-mcp=browser) mcp=browser ;;
		*) die "unknown option: $1" ;;
		esac
		shift
	done
	case $prefix in
	/*/sudoorbell) ;;
	*) die "refusing to install to $prefix: the directory must be an absolute path ending in /sudoorbell" ;;
	esac
	[ -z "$shells" ] || [ "$shells" = all ] && shells=$(detect_shells)
	shells=$(printf '%s' "$shells" | tr ',' ' ')

	if [ -n "$packaged" ]; then
		[ -x "$prefix/libexec/sudoorbell-askpass" ] || die "the package's files are missing from $prefix"
		say "Using $prefix (installed by your package manager)"
	else
		# Copy the program, so the repository can move or go away. Never onto
		# itself: $prefix can be this very directory through a symlink, and
		# clearing it first would delete what is about to be copied.
		if ! same_dir "$src" "$prefix"; then
			mkdir -p "$prefix"
			for d in bin lib libexec shell mcp; do
				rm -rf "${prefix:?}/$d"
				cp -R "$src/$d" "$prefix/$d"
			done
		fi
		chmod 755 "$prefix/bin/sudoorbell" "$prefix/libexec/sudoorbell-askpass" "$prefix/libexec/sudoorbell-prompt" "$prefix/mcp/sudoorbell-mcp"
		mkdir -p "$bindir"
		ln -sf "$prefix/bin/sudoorbell" "$bindir/sudoorbell"
		say "Installed to $prefix (command: $bindir/sudoorbell)"
	fi

	for s in $shells; do
		case $s in
		zsh | bash | sh)
			# zsh's .zshenv is read whole; bash and sh startup files often
			# return early for non-interactive shells, so go on top there.
			where=top
			[ "$s" = zsh ] && where=bottom
			for f in $(rc_files "$s"); do
				add_block "$f" "$where"
				say "  $s: $f"
			done
			;;
		fish)
			mkdir -p "$(dirname "$fish_conf")"
			{
				printf '%s\n' "$MARK_BEGIN"
				printf 'set -gx SUDOORBELL_HOME "%s"\n' "$prefix"
				# shellcheck disable=SC2016 # expanded by fish, not here
				printf 'source "$SUDOORBELL_HOME/shell/sudoorbell.fish"\n'
				printf '%s\n' "$MARK_END"
			} >"$fish_conf"
			say "  fish: $fish_conf"
			;;
		*) die "unsupported shell: $s" ;;
		esac
	done

	if [ -n "$claude" ]; then
		if claude_has_rule; then
			say "  Claude Code: deny rule $CLAUDE_RULE already in $claude_settings"
		else
			# shellcheck disable=SC2016 # $r is a jq variable
			claude_edit '.permissions.deny = (((.permissions.deny // []) - [$r]) + [$r])'
			say "  Claude Code: added deny rule $CLAUDE_RULE to $claude_settings"
		fi
	fi
	if [ -n "$mcp" ]; then
		command -v claude >/dev/null 2>&1 || die "claude not found; cannot register the Claude Code sudo tool"
		command -v python3 >/dev/null 2>&1 || die "python3 is needed for the Claude Code sudo tool"
		claude mcp remove --scope user "$MCP_NAME" >/dev/null 2>&1 || true
		claude mcp add "$MCP_NAME" --scope user -e "SUDOORBELL_MCP_MODE=$mcp" -- "$prefix/mcp/sudoorbell-mcp" >/dev/null
		say "  Claude Code: sudo tool registered ($mcp mode); the password is asked $(
			[ "$mcp" = form ] && echo "inside Claude Code, visible while you type" || echo "on a local page with a hidden field")"
	fi
	say "Open a new terminal (and restart any AI agent) to pick it up. Check with: sudoorbell doctor"
}

cmd_uninstall() {
	claude='' mcp=''
	while [ $# -gt 0 ]; do
		case $1 in
		--claude-deny) claude=1 ;;
		--claude-mcp) mcp=1 ;;
		*) die "unknown option: $1" ;;
		esac
		shift
	done
	for s in zsh bash sh; do
		for f in $(rc_files "$s"); do
			if has_block "$f"; then
				remove_block "$f"
				say "Removed from $f"
			fi
		done
	done
	if [ -f "$fish_conf" ] && grep -qxF "$MARK_BEGIN" "$fish_conf"; then
		rm -f "$fish_conf"
		say "Removed $fish_conf"
	fi
	if [ -n "$packaged" ]; then
		say "The program stays in $prefix: remove it with your package manager (brew uninstall sudoorbell)"
	else
		if [ -L "$bindir/sudoorbell" ]; then
			rm -f "$bindir/sudoorbell"
		fi
		# Only ever delete a directory that is recognisably ours, and never
		# the copy that is running.
		case $prefix in
		*/sudoorbell)
			if ! same_dir "$src" "$prefix" && [ -x "$prefix/libexec/sudoorbell-askpass" ]; then
				rm -rf "${prefix:?}"
				say "Removed $prefix"
			fi
			;;
		esac
	fi
	if [ -n "$claude" ] && claude_has_rule; then
		# shellcheck disable=SC2016 # $r is a jq variable
		claude_edit '.permissions.deny -= [$r]'
		say "Removed deny rule $CLAUDE_RULE from $claude_settings"
	fi
	if [ -n "$mcp" ] && command -v claude >/dev/null 2>&1; then
		claude mcp remove --scope user "$MCP_NAME" >/dev/null 2>&1 && say "Removed the Claude Code sudo tool"
	fi
	say "Open a new terminal for it to take effect."
}

check() {
	# check OK|WARN|FAIL message
	printf '  %-4s %s\n' "$1" "$2"
}

cmd_doctor() {
	os=$(sd_os)
	say "sudoorbell $VERSION on $os"
	sudo_bin=$(command -v sudo 2>/dev/null || true)
	if [ -n "$sudo_bin" ]; then
		check OK "sudo: $sudo_bin ($("$sudo_bin" -V 2>/dev/null | head -1))"
	else
		check FAIL "sudo not found"
	fi

	if [ -x "$prefix/libexec/sudoorbell-askpass" ]; then
		check OK "installed: $prefix"
	else
		check FAIL "not installed at $prefix (run: sudoorbell install)"
	fi

	backend=$(sd_backend)
	case $backend in
	terminal) check OK "no desktop here: requests wait for you to run 'sudoorbell approve' in a terminal (inside tmux 3.2+, a popup opens instead)" ;;
	tmux) check OK "no desktop here, inside tmux: requests open as a tmux popup" ;;
	*) check OK "dialog: $backend" ;;
	esac
	if [ "$os" = linux ] && sd_has_display; then
		check OK "display: ${WAYLAND_DISPLAY:-${DISPLAY:-socket}} (sudo uses the dialog by itself here, even without the shell function)"
	fi

	if [ "${SUDO_ASKPASS:-}" = "$prefix/libexec/sudoorbell-askpass" ]; then
		check OK "this shell: SUDO_ASKPASS points at sudoorbell"
	elif [ -n "${SUDO_ASKPASS:-}" ]; then
		check WARN "this shell: SUDO_ASKPASS is $SUDO_ASKPASS, not sudoorbell"
	else
		check WARN "this shell: SUDO_ASKPASS is not set (open a new terminal after installing)"
	fi

	# What a tool sees when it runs a command through your shell, with no
	# terminal: the way AI agents and editors run commands.
	# shellcheck disable=SC2016 # expanded by the probed shell
	posix_probe='echo "$SUDO_ASKPASS"; if type sudo 2>/dev/null | grep -q function; then echo function; fi'
	if command -v zsh >/dev/null 2>&1; then
		probe_shell "zsh -c" "$posix_probe" zsh -c
	fi
	if command -v bash >/dev/null 2>&1; then
		probe_shell "bash -c" "$posix_probe" bash -c
		probe_shell "bash -lc" "$posix_probe" bash -lc
	fi
	probe_shell "sh -lc" "$posix_probe" sh -lc
	if command -v fish >/dev/null 2>&1; then
		# shellcheck disable=SC2016 # expanded by fish
		probe_shell "fish -c" 'echo "$SUDO_ASKPASS"; if functions -q sudo; echo function; end' fish -c
	fi

	for s in zsh bash sh; do
		for f in $(rc_files "$s"); do
			[ -f "$f" ] || continue
			if has_block "$f"; then
				check OK "startup file: $f"
			fi
			if without_block "$f" | grep -q 'SUDO_ASKPASS\|sudo()\|function sudo'; then
				check WARN "$f also sets SUDO_ASKPASS or defines sudo outside the sudoorbell block; remove that to avoid conflicts"
			fi
		done
	done

	claude_json=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
	mode=''
	if [ -f "$claude_json" ]; then
		mode=$(jq -r --arg n "$MCP_NAME" '.mcpServers[$n].env.SUDOORBELL_MCP_MODE // empty' "$claude_json" 2>/dev/null || true)
	fi
	case $mode in
	form) check OK "Claude Code: sudo tool registered; password asked inside Claude Code (visible while typed)" ;;
	browser) check OK "Claude Code: sudo tool registered; password asked on a local page with a hidden field" ;;
	*) [ -f "$claude_json" ] && check OK "Claude Code: no sudo tool (optional: sudoorbell install --claude-mcp)" ;;
	esac
	if [ -f "$claude_settings" ] && ! command -v jq >/dev/null 2>&1; then
		check WARN "Claude Code: cannot read its settings without jq; the deny rule and sudo tool were not checked"
	elif [ -f "$claude_settings" ]; then
		if claude_has_rule; then
			check OK "Claude Code: sudo is denied to the agent ($CLAUDE_RULE); you run it yourself with !sudo"
		else
			check WARN "Claude Code: no $CLAUDE_RULE deny rule; the agent can run sudo and you approve each in the dialog"
		fi
	fi
}

# probe_shell LABEL SCRIPT SHELL ARGS...: what SHELL reports when started fresh
# with no terminal and stdin closed, the way an agent runs a command.
probe_shell() {
	label=$1 script=$2
	shift 2
	out=$(env -u SUDO_ASKPASS -u SUDOORBELL_HOME "$@" "$script" </dev/null 2>/dev/null || true)
	askpass=$(printf '%s\n' "$out" | sed -n 1p)
	if [ "$askpass" = "$prefix/libexec/sudoorbell-askpass" ]; then
		if printf '%s\n' "$out" | grep -qx function; then
			check OK "$label: dialog active"
		else
			check WARN "$label: SUDO_ASKPASS set but no sudo function (enough on a Linux desktop, not on macOS)"
		fi
	else
		check WARN "$label: not active (this shell does not read a startup file with the sudoorbell block)"
	fi
}

cmd_preview() {
	backend=$(sd_backend)
	case $backend in
	terminal | tmux) die "no desktop here: requests are answered with 'sudoorbell approve' instead of a dialog" ;;
	esac
	message=$(sd_message "sudo apt install example-package" "sudoorbell preview" 1)
	# The preview never keeps what is typed.
	if sd_show "$message" "$backend" >/dev/null; then
		say "Allow pressed (input discarded)."
	else
		say "Deny pressed, or the dialog timed out."
	fi
}

# Answer the requests waiting for a terminal, oldest first.
#   --deny       refuse them
#   --pending    list them, one per line: the sudo process id, a tab, the command
#   --pid N      only the request of sudo process N
#   --stdin      read the password from standard input instead of a terminal
#                (for programs such as the Claude Code plugin; needs --pid)
cmd_approve() {
	deny='' pending='' only='' stdin=''
	while [ $# -gt 0 ]; do
		case $1 in
		--deny) deny=1 ;;
		--pending) pending=1 ;;
		--stdin) stdin=1 ;;
		--pid)
			[ $# -ge 2 ] || die "--pid needs a value"
			case $2 in '' | *[!0-9]*) die "--pid needs a process id" ;; esac
			only=$2
			shift
			;;
		*) die "unknown option: $1" ;;
		esac
		shift
	done
	[ -z "$stdin" ] || [ -n "$only" ] || [ -n "$deny" ] || die "--stdin needs --pid, so the password goes to the request you meant"
	dir=$(sd_state_dir) || die "no private state directory"
	found=''
	for req in "$dir"/req.*; do
		[ -f "$req" ] || continue
		pid=${req##*/req.}
		[ -z "$only" ] || [ "$pid" = "$only" ] || continue
		fifo=$dir/fifo.$pid
		[ -p "$fifo" ] || continue
		found=1
		if [ -n "$pending" ]; then
			printf '%s\t%s\n' "$pid" "$(sed -n 3p "$req")"
			continue
		fi
		if [ -n "$deny" ]; then
			printf 'D\n' >"$fifo"
			say "Denied: $(sed -n 3p "$req")"
			continue
		fi
		if [ -n "$stdin" ]; then
			# One line, kept out of argv and the environment, never echoed.
			IFS= read -r password || password=''
			printf 'P%s\n' "$password" >"$fifo"
			password=''
			continue
		fi
		[ -t 0 ] || die "approve needs a terminal to read the password (or use --deny)"
		"$src/libexec/sudoorbell-prompt" "$req" "$fifo" || true
	done
	if [ -z "$found" ]; then
		[ -n "$pending" ] && return 0
		[ -n "$only" ] && die "no sudo request is waiting for process $only"
		say "No sudo request is waiting."
	fi
}

case ${1:-help} in
install)
	shift
	cmd_install "$@"
	;;
uninstall)
	shift
	cmd_uninstall "$@"
	;;
doctor) cmd_doctor ;;
preview) cmd_preview ;;
approve)
	shift
	cmd_approve "$@"
	;;
version | --version) say "$VERSION" ;;
help | -h | --help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
